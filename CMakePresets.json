{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "SYNO Windows Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/_build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SYNO_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "SYNO Windows Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/_build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYNO_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    }
  ]
}
